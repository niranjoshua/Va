# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.

VATICORE_ENVIRONMENT=local
VATICORE_LOG_LEVEL=INFO
# text locally; json in staging and production, for hosted log search.
VATICORE_LOG_FORMAT=text

# Local development uses DuckDB. Point at Postgres/TimescaleDB in production.
VATICORE_DATABASE_URL=duckdb:///vaticore.duckdb

# Weather for live forecasts: open-meteo or none. Open-Meteo's free API is for
# non-commercial use; commercial use needs an API subscription key. Without a
# key, production runs skip live weather.
VATICORE_WEATHER_PROVIDER=open-meteo
# VATICORE_WEATHER_API_KEY=

# Experiment tracking (MLflow). Leave unset to disable; backtests then run
# without logging. Set to a local store or a tracking server to log every model
# comparison (site, model, config, metrics). Requires the "tracking" extra.
# Examples:
#   VATICORE_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
#   VATICORE_MLFLOW_TRACKING_URI=http://localhost:5000
# VATICORE_MLFLOW_TRACKING_URI=

# Daily pipeline (python -m vaticore.pipeline). The recipients file holds phone
# numbers: keep it outside the repository. See docs/pipeline.md.
# VATICORE_PORTFOLIO_FILE=examples/sites/nigeria_portfolio.toml
# VATICORE_RECIPIENTS_FILE=/secure/path/recipients.toml
# VATICORE_PLAN_STORE_URL=            # defaults to VATICORE_DATABASE_URL

# WhatsApp Business Cloud API. See docs/whatsapp-setup.md. Never commit these.
# VATICORE_WHATSAPP_TOKEN=
# VATICORE_WHATSAPP_PHONE_NUMBER_ID=
# VATICORE_WHATSAPP_API_VERSION=v23.0
# VATICORE_WHATSAPP_TEMPLATE_NAME=vaticore_daily_plan
# VATICORE_WHATSAPP_TEMPLATE_LANGUAGE=en
# Other plan languages, once their templates are approved (docs/whatsapp-setup.md):
# VATICORE_WHATSAPP_EXTRA_TEMPLATES=pcm=vaticore_daily_plan_pcm:en
# VATICORE_WHATSAPP_APP_SECRET=
# VATICORE_WHATSAPP_VERIFY_TOKEN=

# Email delivery (SMTP). Any provider works; use an app password, not your own.
# VATICORE_SMTP_HOST=smtp.gmail.com
# VATICORE_SMTP_PORT=587
# VATICORE_SMTP_USERNAME=plans@vaticore.com
# VATICORE_SMTP_PASSWORD=
# VATICORE_EMAIL_FROM=Vaticore <plans@vaticore.com>
# VATICORE_EMAIL_REPLY_TO=hello@vaticore.com

# Monitoring connectors (python -m vaticore.pipeline ingest). The sources file
# names each site's connector; tokens stay in the environment, for example:
# VATICORE_SOURCES_FILE=/secure/sources.toml
# VATICORE_VRM_TOKEN=

# Model monitoring alerts (a model suspended or reinstated), emailed over the
# SMTP settings above. Unset: alerts are printed and logged only.
# VATICORE_OPS_EMAIL=ops@vaticore.com

# Operations (docs/operations.md). Admin token: required outside local
# development; operators get their own keys with `apikey create`.
# VATICORE_API_TOKEN=
# VATICORE_SENTRY_DSN=
# VATICORE_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# An empty database kept for restore checks, never a real one.
# VATICORE_RESTORE_TEST_URL=postgresql://user:password@host:5432/vaticore_restore_scratch
